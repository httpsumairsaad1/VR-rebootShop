<style>
  .bubble {
    flex-direction: column;
    width: 40;
    gap: 2;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 3;
    padding-right: 3;
  }
  .label {
    color: #2f8f86;
    font-size: 2.4;
    font-weight: 700;
  }
  .label:dark {
    color: #4cc38a;
  }
  .message {
    color: #3b2a22;
    font-size: 3.2;
    font-weight: 700;
  }
  .message:dark {
    color: #eaf4f2;
  }
  .detail {
    color: #3b2a22;
    font-size: 2.4;
  }
  .detail:dark {
    color: #eaf4f2;
  }
  .symptom-chip {
    padding-top: 1.5;
    padding-bottom: 1.5;
    padding-left: 2;
    padding-right: 2;
    border-radius: 2;
    background-color: #e5533d;
    color: #ffffff;
    font-size: 2.4;
    font-weight: 700;
  }
</style>
<Panel class="bubble">
  <div id="speech-name" class="label">CUSTOMER / MINA</div>
  <div id="speech-line" class="message">My phone stopped charging.</div>
  <div id="speech-symptom" class="symptom-chip">WON'T CHARGE</div>
  <div id="speech-offer" class="detail">Repair offer: 45 coins</div>
</Panel>
