<meta preferred-color-scheme="light" />
<style>
  .hud { width: 56; height: 13; flex-direction: column; justify-content: space-between; padding: 1.2; background-color: rgba(247, 235, 212, 0.95); border-color: #3b2a22; border-width: 0.3; border-radius: 2; }
  .row { width: 53.6; flex-direction: row; justify-content: space-between; align-items: center; }
  .chip { font-size: 2.6; font-weight: 700; color: #3b2a22; }
  .gold { color: #b8860b; }
  .track { width: 52.8; height: 0.9; background-color: #d9c7a0; border-radius: 0.45; }
  .fill { width: 0; height: 0.9; background-color: #ff8a3d; border-radius: 0.45; }
  .hint { width: 53.6; font-size: 2.3; color: #5b3d2c; }
</style>
<Panel width="56" height="13">
  <div class="hud">
    <div class="row"><span id="hud-day" class="chip">DAY 1</span><span id="hud-money" class="chip gold">$150</span><span id="hud-rating" class="chip">RATING --</span><span id="hud-level" class="chip">LV 1</span></div>
    <div class="track"><div id="hud-xp" class="fill"></div></div>
    <span id="hud-hint" class="hint">Welcome to Reboot Lab.</span>
  </div>
</Panel>
