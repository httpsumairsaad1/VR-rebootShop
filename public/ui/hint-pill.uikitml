<style>
  .panel-root {
    flex-direction: row;
    width: 36;
    gap: 2;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2.5;
    padding-right: 2.5;
    align-items: center;
  }
  .icon {
    color: #3b2a22;
    font-size: 3.2;
    font-weight: 700;
  }
  .icon:dark {
    color: #1b2a30;
  }
  .hint-text {
    color: #3b2a22;
    font-size: 3.2;
    font-weight: 600;
  }
  .hint-text:dark {
    color: #eaf4f2;
  }
  .hint-chip {
    border-radius: 2;
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 1.5;
    padding-right: 1.5;
    background-color: #f2b63c;
  }
</style>
<Panel class="panel-root">
  <div class="hint-chip"><div id="hint-icon" class="icon">i</div></div>
  <div id="hint-text" class="hint-text">Flip the phone to inspect its back.</div>
</Panel>
