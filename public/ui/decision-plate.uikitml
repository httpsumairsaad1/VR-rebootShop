<style>
  .panel-root {
    flex-direction: column;
    width: 38;
    gap: 2;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 3;
    padding-right: 3;
  }
  .eyebrow {
    color: #e5533d;
    font-size: 2.4;
    font-weight: 700;
  }
  .eyebrow:dark {
    color: #ff8a3d;
  }
  .heading {
    color: #3b2a22;
    font-size: 4;
    font-weight: 700;
  }
  .heading:dark {
    color: #eaf4f2;
  }
  .choice {
    color: #3b2a22;
    font-size: 2.4;
    font-weight: 600;
  }
  .choice:dark {
    color: #eaf4f2;
  }
  .rush {
    color: #3b2a22;
    font-size: 2.4;
    font-weight: 700;
  }
  .rush-card {
    padding-top: 1.5;
    padding-bottom: 1.5;
    padding-left: 2;
    padding-right: 2;
    border-radius: 2;
    background-color: #f2b63c;
  }
</style>
<Panel class="panel-root">
  <div id="decision-eyebrow" class="eyebrow">PART OUT OF STOCK</div>
  <div id="decision-heading" class="heading">Choose what happens next</div>
  <div class="rush-card"><div id="decision-rush" class="rush">RUSH IT NOW / 10 coins</div></div>
  <div id="decision-park" class="choice">PARK IT / order for tomorrow</div>
  <div id="decision-continue" class="choice">KEEP WORKING / choose another step</div>
</Panel>
