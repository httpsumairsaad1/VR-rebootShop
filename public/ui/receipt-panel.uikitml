<meta preferred-color-scheme="light" />
<style>
  .paper { width: 34; height: 28; flex-direction: column; justify-content: space-between; padding: 2; background-color: #fffdf6; border-color: #3b2a22; border-width: 0.3; border-radius: 1.5; }
  .title { font-size: 3.4; font-weight: 700; color: #3b2a22; }
  .t { font-size: 2.6; color: #3b2a22; }
  .btn { width: 30; height: 5.4; background-color: #ff8a3d; border-radius: 1.4; font-size: 2.6; font-weight: 700; color: #ffffff; }
  .btn:hover { background-color: #ffa464; }
</style>
<Panel width="34" height="28">
  <div class="paper">
    <span id="rc-title" class="title">DAY COMPLETE</span>
    <span id="rc-1" class="t">Repairs: 0</span><span id="rc-2" class="t">Earned: $0</span><span id="rc-3" class="t">Average rating: 0</span><span id="rc-4" class="t">Medal</span>
    <button id="rc-open" class="btn">OPEN NEXT DAY</button>
  </div>
</Panel>
