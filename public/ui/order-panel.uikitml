<meta preferred-color-scheme="light" />
<style>
  .card { width: 52; height: 21; flex-direction: column; justify-content: space-between; padding: 2; background-color: rgba(255, 250, 238, 0.96); border-color: #3b2a22; border-width: 0.35; border-radius: 3; }
  .name { font-size: 4; font-weight: 700; color: #3b2a22; }
  .chip { font-size: 3; font-weight: 700; color: #ffffff; background-color: #e5533d; padding: 0.6; border-radius: 1.2; }
  .line { width: 48; font-size: 3.2; color: #3b2a22; }
  .fee { font-size: 3.2; font-weight: 700; color: #b8860b; }
  .status { font-size: 2.8; font-weight: 700; color: #2f8f86; }
  .board { width: 52; height: 42; flex-direction: column; gap: 0.3; padding: 1.5; background-color: rgba(247, 235, 212, 0.98); border-color: #3b2a22; border-width: 0.3; border-radius: 2; }
  .title { font-size: 2.6; font-weight: 700; color: #3b2a22; }
  .timer { font-size: 2.4; font-weight: 700; color: #e5533d; }
  .entry { width: 48; height: 2.8; font-size: 2.2; color: #4a3326; }
  .tab { width: 56; height: 42; flex-direction: column; padding: 1; }
</style>
<Panel width="56" height="44">
  <div class="tab">
    <div id="order-card" class="card">
      <span id="ord-name" class="name">Customer</span>
      <span id="ord-chip" class="chip">Symptom</span>
      <span id="ord-line" class="line">Hello!</span>
      <span id="ord-fee" class="fee">Offer: $0</span>
      <span id="ord-status" class="status">Waiting</span>
    </div>
    <div id="repair-log" class="board" style="display: none">
      <span class="title">REPAIR LOG</span><span id="log-timer" class="timer">0:00</span>
      <span id="log-1" class="entry"></span><span id="log-2" class="entry"></span><span id="log-3" class="entry"></span>
      <span id="log-4" class="entry"></span><span id="log-5" class="entry"></span><span id="log-6" class="entry"></span>
      <span id="log-7" class="entry"></span><span id="log-8" class="entry"></span><span id="log-9" class="entry"></span>
    </div>
  </div>
</Panel>
