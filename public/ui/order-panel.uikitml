<meta preferred-color-scheme="light" />
<style>
  .card { width: 56; height: 26; flex-direction: column; justify-content: space-between; padding: 2; background-color: rgba(255, 250, 238, 0.96); border-color: #3b2a22; border-width: 0.35; border-radius: 3; }
  .name { font-size: 4; font-weight: 700; color: #3b2a22; }
  .chip { font-size: 3; font-weight: 700; color: #ffffff; background-color: #e5533d; padding: 0.6; border-radius: 1.2; }
  .line { width: 52; font-size: 3.4; color: #3b2a22; }
  .fee { font-size: 3.2; font-weight: 700; color: #b8860b; }
  .status { font-size: 2.8; font-weight: 700; color: #2f8f86; }
</style>
<Panel width="56" height="26">
  <div class="card">
    <span id="ord-name" class="name">Customer</span>
    <span id="ord-chip" class="chip">Symptom</span>
    <span id="ord-line" class="line">Hello!</span>
    <span id="ord-fee" class="fee">Offer: $0</span>
    <span id="ord-status" class="status">Waiting</span>
  </div>
</Panel>
